  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.78.0",
    "postcss": "^8.5.26",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.14.1",
